# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채우세요. (.env.local 은 git에 올리지 않아요)
# 값을 바꾼 뒤에는 개발 서버(pnpm dev)를 껐다 켜야 반영돼요.

# 백엔드 주소. 비워 두면 서버 없이 mock(데모) 모드로 동작해요.
# Spring 로컬 실행 예: http://localhost:8080
VITE_API_BASE_URL=

# true로 두면 주소가 있어도 mock으로 동작해요. 서버 연결을 끄고 화면만 볼 때 사용.
VITE_USE_MOCK=false

# (개발용) mock 모드에서 긴급대응 '질문'을 로컬 AI 서버로 보내 Gemini 답변을 확인할 때만 채워요.
# 예: http://localhost:8000  (AI 서버 .env 에 DEV_CORS_ORIGINS=http://localhost:8443 도 필요)
VITE_AI_DEV_URL=
