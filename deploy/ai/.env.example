# [배포용] WSID_AI/.env.example 을 그대로 가져왔어요 (develop 5b4c37a 기준).
# 복사해서 같은 폴더에 .env 로 저장: cp .env.example .env  (권한: chmod 600 .env)
# 운영에서 꼭 바꿀 값: LLM_PROVIDER, LLM_API_KEY, LLM_MODEL, AI_API_KEY(BE와 같은 값), OPENAI_API_KEY
# RAG 인덱스 옵션 (비우면 전체 문단 사용. 검토 완료 문단만 쓰려면 --reviewed-only)
RAG_INDEX_ARGS=

# 이 파일을 복사해서 같은 폴더에 ".env" 라는 이름으로 저장하세요.
# .env 에는 API 키가 들어가므로 절대 GitHub 에 올리지 마세요. (.gitignore 에 이미 등록됨)

# 어떤 LLM 을 쓸지: mock | openai | anthropic
#   mock      : API 키 없이 가짜 응답으로 연습 (처음엔 이걸로 시작)
#   openai    : OpenAI 또는 OpenAI 호환 API (Gemini, Upstage 등은 LLM_BASE_URL 지정)
#   anthropic : Claude API
LLM_PROVIDER=mock

# 실제 LLM 을 쓸 때만 채우기
LLM_API_KEY=
# 공급자 콘솔/문서에서 정확한 모델 이름을 확인해서 넣으세요
#   예) anthropic: claude-sonnet-5-5   openai: gpt-6-luna
LLM_MODEL=
# Claude 대사 다양성 (0.6~0.8 권장, JSON 이 자주 깨지면 0.5)
LLM_TEMPERATURE=0.7
# 상황 파악 질문용 모델 (비우면 LLM_MODEL). 비용을 줄이려면 claude-haiku-5-5
DISCOVERY_MODEL=
# 시나리오 계획·비교·검토 단계 모델 (비우면 LLM_MODEL). 최종 시나리오 글은 LLM_MODEL 이 써요
PIPELINE_MODEL=
# OpenAI 호환 API 를 쓸 때만 (비워두면 OpenAI 기본 주소)
LLM_BASE_URL=

# LLM 한 번 호출할 때 기다리는 최대 시간(초). 재시도 1회 포함해도 25초 안에 끝나도록 10초 권장
LLM_TIMEOUT_SECONDS=10

# 상황 파악 대화에서 사용자에게 물어볼 최대 질문 수
MAX_CONTEXT_TURNS=5

# 시나리오 생성 1번에 기다리는 최대 시간(초). 시나리오는 길어서 따로 설정
SCENARIO_TIMEOUT_SECONDS=25

# 가상 훈련 대화 전체 최대 턴 수
TRAINING_MAX_TURNS=15
# 이 답변 수 전에는 시나리오가 끝나도 대화를 이어가요 (사용자가 차단·신고 등으로 확실히 끊으면 예외)
TRAINING_MIN_TURNS=6

# Spring의 AI_API_KEY와 같은 값으로 설정. 비어 있으면 모든 내부 API가 503이에요.
# 로컬은 Spring 기본값(local-dev-key) 그대로 두고, 배포 환경은 두 서버에 같은 비밀값을 넣으세요.
AI_API_KEY=

# 기본 PaddleOCR. Tesseract로 되돌리려면 tesseract로 변경
OCR_ENGINE=paddle
# Paddle 로드에 실패해도 서버는 뜨고 OCR만 503. 사진 분류 대기(초), 동시 요청 대기(초)
OCR_CLASSIFY_TIMEOUT_SECONDS=10
# 사진 분류·요약은 위의 LLM_API_KEY 사용. 모델은 비우면 LLM_MODEL, 빠른 모델로 따로 지정 가능
OCR_CLASSIFY_MODEL=
OCR_QUEUE_WAIT_SECONDS=5
# 사진 글자 인식 제한(초, 대기 포함). CPU가 느려 사진 한 장에 15초를 넘기면 늘려요.
# 늘리면 Spring AI_OCR_READ_TIMEOUT(기본 30s)도 이 값 + 분류 시간보다 길게 맞춰요.
OCR_TIMEOUT_SECONDS=15
# Tesseract 사용 시 실행 파일과 언어 데이터
OCR_EXECUTABLE=tesseract
OCR_LANGUAGES=kor+eng

# 피해 대응 RAG: 답변 모델과 키는 위의 LLM_MODEL과 LLM_API_KEY 사용
# Claude(LLM_PROVIDER=anthropic)를 쓸 때 검색용 임베딩은 OpenAI 키가 따로 필요해요 (Claude 에는 임베딩이 없음).
# 비워 두면 글자 겹침 검색으로 대신해요 (정확도는 조금 낮아요)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
RAG_TIMEOUT_SEC=30
# 1이면 네트워크 없이 가짜 모드
RAG_FAKE=0

# 상담 assist PLAN/ANSWER 각각의 전체 요청 시간 제한(초). Spring read timeout(기본 20s)보다 짧게
ASSIST_PLAN_TIMEOUT_SEC=15
ASSIST_ANSWER_TIMEOUT_SEC=15
# 재검색은 최대 2회까지 허용; 시간 부족 시 조기 종료
ASSIST_MAX_RESEARCHES=1
ASSIST_RETRY_MIN_SECONDS=7
# 비우면 LLM_MODEL 사용. 추론 모델이면 low로 지정해 판단 속도를 줄일 수 있음 (모델 지원 확인 필요)
ASSIST_LLM_MODEL=
ASSIST_REASONING_EFFORT=

# 모든 시나리오 모델 단계·재시도를 합친 제한. BE는 이보다 길게(기본 120초), FE는 130초.
SCENARIO_TOTAL_TIMEOUT_SECONDS=110

# 상황 파악: 호출 60초, 재시도·응답 교정 포함 전체 110초(BE 120초·FE 130초 안).
DISCOVERY_TIMEOUT_SECONDS=60
DISCOVERY_TOTAL_TIMEOUT_SECONDS=110
