# 복사해서 같은 폴더에 .env 로 저장: cp .env.example .env  (권한: chmod 600 .env)
# .env 에는 비밀번호가 들어가요. git 에 올리거나 채팅에 붙여 넣지 마세요.

# ── 주소 ──
# DuckDNS 등에서 만든 주소 (https:// 없이)
DOMAIN=wsid.duckdns.org
# Let's Encrypt 인증서 알림 메일 (비워도 됨). 인증서는 certbot 컨테이너가 자동 발급·갱신
ACME_EMAIL=

# ── DB (RDS) ──
DB_URL=jdbc:postgresql://RDS엔드포인트:5432/wsid?sslmode=require
DB_USERNAME=wsid
DB_PASSWORD=

# ── AI 서버 ──
AI_MODE=http
# AI EC2의 "프라이빗" IP
AI_BASE_URL=http://AI프라이빗IP:8000
# AI 서버 .env 의 AI_API_KEY 와 같은 값. 만들기: openssl rand -hex 32
AI_API_KEY=

# ── 회원가입 인증 메일 (Gmail 앱 비밀번호 예시) ──
AUTH_MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=보내는주소@gmail.com
MAIL_PASSWORD=
MAIL_FROM=보내는주소@gmail.com
