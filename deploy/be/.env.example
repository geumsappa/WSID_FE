# BE 서버 설정. GitHub Actions에서는 WSID_BE 레포 시크릿 BE_ENV 에 이 내용 전체를 넣어요.
# .env 에는 비밀번호가 들어가요. git 에 올리거나 채팅에 붙여 넣지 마세요.

# ── 주소 ──
# 사용자가 접속하는 FE 주소 (https:// 없이). CORS 허용에 써요
DOMAIN=wsid.duckdns.org

# ── DB (RDS) ──
DB_URL=jdbc:postgresql://wsid-db.cjy2wck4g0ce.ap-southeast-2.rds.amazonaws.com:5432/wsid?sslmode=require
DB_USERNAME=wsid
DB_PASSWORD=

# ── AI 서버 ──
AI_MODE=http
# AI EC2의 "프라이빗" IP
AI_BASE_URL=http://172.31.34.221:8000
# AI 서버 .env 의 AI_API_KEY 와 같은 값. 만들기: openssl rand -hex 32
AI_API_KEY=

# ── 회원가입 인증 메일 (Gmail 앱 비밀번호 예시) ──
AUTH_MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=보내는주소@gmail.com
MAIL_PASSWORD=
MAIL_FROM=보내는주소@gmail.com
